# KnowMemo configuration example (design doc §29).
# Copy to knowmemo.yaml and edit, or export KNOWMEMO_* environment variables.
#
# Environment variables override the YAML file. Nested keys use a double
# underscore:  KNOWMEMO_APP__LOG_LEVEL=DEBUG  ->  app.log_level
# Secrets (weknora.api_key) should come from the environment, never from YAML.

app:
  name: KnowMemo
  environment: development
  log_level: INFO
  log_json: true

storage:
  database_url: sqlite:///./data/knowmemo.db

wechat:
  enabled: false
  # Directory holding the *encrypted* WeChat data. KnowMemo never reads this;
  # it is used by `knowmemo source scan wechat` only to report availability.
  data_path: null
  # Directory holding a *plaintext* SQLite snapshot of WeChat databases.
  # This is the connector's actual input contract. See docs/plan.md decision D4.
  snapshot_path: null

weknora:
  base_url: http://localhost:8080
  api_key: null
  knowledge_base_id: null
  timeout_seconds: 30.0

llm:
  provider: ollama
  base_url: http://localhost:11434
  model: qwen3.5:9b
  timeout_seconds: 120.0

embedding:
  provider: ollama
  base_url: http://localhost:11434
  # WeKnora requires an embedding model. Pull one first, e.g.:
  #   ollama pull bge-m3
  model: null

processing:
  enable_summary: false
  enable_entity_extraction: false

segmentation:
  inactivity_minutes: 60
  max_messages: 100
  max_tokens: 4000
  # Bumped manually when segmentation parameters change. It participates in
  # segment ID hashing so that re-tuning becomes an explicit re-index instead
  # of a silent full re-ingest. See docs/plan.md §1.3.
  version: 1
